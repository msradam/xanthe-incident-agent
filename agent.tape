# Records the agent driving the runbook with a real model.
# Needs ANTHROPIC_API_KEY set. Tune the final Sleep to the run length.
Output demo.gif

Require node

Set Shell bash
Set FontSize 22
Set Width 1100
Set Height 700
Set Padding 16
Set Margin 24
Set MarginFill "#11111b"
Set BorderRadius 12
Set WindowBar Colorful
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms

Sleep 600ms
Type "npm run agent"
Sleep 400ms
Enter
Sleep 45s
Sleep 1500ms
